{
  "name": "dsh-tavern-rewrite",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "revnovel润色：DSH Tavern 正文润色插件，正文写完后调用 revnovel API 润色，再替换成润色后的正文。",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/polish.test.mjs",
    "test:plugin": "node --test tests/plugin.test.mjs",
    "install:tavern": "node scripts/install.mjs"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "dsh-tavern-plugin"
      ]
    }
  }
}
